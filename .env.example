# Isko .env naam se copy karo. .env ko git mein kabhi commit mat karo.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,tasks.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
DJANGO_DB_PASSWORD=change-me
# HTTP par test kar rahe ho to False; HTTPS lagane ke baad True (ya hata do)
DJANGO_HTTPS=False
DJANGO_CURRENCY_SYMBOL=₹
# Email (password reset aur notifications). Default console hai: email sirf logs mein print hota hai.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USER=
# DJANGO_EMAIL_PASSWORD=
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_FROM_EMAIL=Taskboard <noreply@example.com>
